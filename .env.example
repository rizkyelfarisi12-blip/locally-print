# LocalPrint - konfigurasi opsional. Salin file ini menjadi ".env" (installer membuatnya otomatis).
# Baris berawalan # diabaikan. Perubahan butuh restart aplikasi (jalankan restart.bat).

# Port web. 80 = cukup ketik http://IP-KOMPUTER tanpa nomor port.
PORT=80

# PIN untuk mencetak (kosong = tanpa PIN) dan PIN halaman Admin.
# Admin tanpa PIN hanya bisa dibuka dari komputer server itu sendiri.
PIN=
ADMIN_PIN=

# Lokasi program pendukung. Dikosongkan = dicari otomatis.
# Bisa juga diatur lewat halaman Admin (http://localhost/admin.html); pengaturan di sana diprioritaskan.
#SUMATRA=C:\Program Files\SumatraPDF\SumatraPDF.exe
#SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe
#GS=C:\Program Files\gs\gs10.08.0\bin\gswin64c.exe

# Opsional
#MAX_MB=25
#MAX_COPIES=20
#ALLOW_PREFIX=192.168.,10.,172.,127.,::1,::ffff:
#DATA_DIR=D:\LocalPrintData
